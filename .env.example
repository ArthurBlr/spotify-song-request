# Réglages pour le lancement sur ton ordinateur. `npm start` crée le fichier .env tout seul ;
# tu peux aussi copier ce modèle en .env et le remplir à la main.
# Sur Vercel, ces valeurs se règlent dans Settings > Environment Variables.

# Identifiants de ton app Spotify (developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Rempli tout seul quand tu relies ton compte Spotify (http://127.0.0.1:3000/api/login)
SPOTIFY_REFRESH_TOKEN=

# Code à donner aux personnes autorisées à demander des titres (vide = page ouverte à tous)
ACCESS_CODE=

# Délai minimum entre deux demandes d'un même navigateur, en secondes (0 = pas de délai)
COOLDOWN_SECONDS=3
